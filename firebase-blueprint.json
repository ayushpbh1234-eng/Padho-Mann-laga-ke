{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User-specific Focus Garden profile, role (child or parent), onboarding state, syllabus topics, tailored challenges, mood check-in, and reverse alarm time.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase user UID."
        },
        "role": {
          "type": "string",
          "description": "User role in Focus Garden.",
          "enum": ["child", "parent"]
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown to linked family members."
        },
        "linkedParentUid": {
          "type": "string",
          "description": "UID of linked parent if this user is a supervised child."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether the user has completed their study & syllabus setup."
        },
        "currentStudy": {
          "type": "string",
          "description": "User's current course, class, or exam."
        },
        "syllabusText": {
          "type": "string",
          "description": "User-entered syllabus text or extracted summary."
        },
        "studySummary": {
          "type": "string",
          "description": "Short personalized summary of the user's syllabus plan."
        },
        "syllabusTopics": {
          "type": "array",
          "description": "Extracted or tailored syllabus chapters/topics."
        },
        "customChallenges": {
          "type": "array",
          "description": "Personalized Pehli Line micro-challenges."
        },
        "mood": {
          "type": "string",
          "description": "Latest check-in mood.",
          "enum": ["thaki", "bored", "energetic"]
        },
        "challengeIdx": {
          "type": "integer",
          "description": "Current index in the Pehli Line Challenge rotation."
        },
        "alarmTime": {
          "type": "string",
          "description": "Reverse study alarm target time in HH:mm 24-hour format."
        },
        "subjectsText": {
          "type": "string",
          "description": "Comma-separated subjects."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": ["userId", "challengeIdx", "subjectsText", "createdAt", "updatedAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "A single focus timer session with subject, ambient sound, completion status, reward, and distraction reasons.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase user UID."
        },
        "authorizedParentUids": {
          "type": "array",
          "description": "Denormalized UIDs of linked parents allowed to inspect this session."
        },
        "day": {
          "type": "string",
          "description": "Local calendar date string YYYY-MM-DD."
        },
        "subject": {
          "type": "string",
          "description": "Study subject name."
        },
        "sound": {
          "type": "string",
          "description": "Selected ambient sound label."
        },
        "durationMinutes": {
          "type": "integer",
          "description": "Planned session duration in minutes."
        },
        "done": {
          "type": "boolean",
          "description": "Whether the session completed without giving up or distraction."
        },
        "rewardText": {
          "type": "string",
          "description": "Motivational reward earned on completion."
        },
        "distractionReasons": {
          "type": "array",
          "description": "Distraction reason labels logged during the session."
        },
        "distractionCount": {
          "type": "integer",
          "description": "Number of distractions logged."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "day",
        "subject",
        "sound",
        "durationMinutes",
        "done",
        "distractionReasons",
        "distractionCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "PairingCode": {
      "title": "PairingCode",
      "description": "One-time 6-character code generated by a child user so a parent can link accounts with explicit consent.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "childUid": { "type": "string" },
        "childName": { "type": "string" },
        "active": { "type": "boolean" },
        "usedByParentUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "childUid", "childName", "active", "createdAt", "updatedAt"]
    },
    "FamilyLink": {
      "title": "FamilyLink",
      "description": "Active parent-child supervision link authorizing the parent to view child phone activity and manage parental rules.",
      "type": "object",
      "properties": {
        "parentUid": { "type": "string" },
        "childUid": { "type": "string" },
        "parentName": { "type": "string" },
        "childName": { "type": "string" },
        "pairingCode": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["active", "revoked"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["parentUid", "childUid", "parentName", "childName", "pairingCode", "status", "createdAt", "updatedAt"]
    },
    "ChildDeviceState": {
      "title": "ChildDeviceState",
      "description": "Real-time phone-wide telemetry, installed/used apps screen time, battery status, active foreground app, and daily study progress synced from the child's device.",
      "type": "object",
      "properties": {
        "childUid": { "type": "string" },
        "childName": { "type": "string" },
        "deviceModel": { "type": "string" },
        "androidVersion": { "type": "string" },
        "batteryPercent": { "type": "integer" },
        "isCharging": { "type": "boolean" },
        "usageAccessGranted": { "type": "boolean" },
        "notificationsGranted": { "type": "boolean" },
        "supervisionServiceRunning": { "type": "boolean" },
        "currentForegroundApp": { "type": "string" },
        "currentForegroundPackage": { "type": "string" },
        "totalPhoneScreenMinutesToday": { "type": "integer" },
        "isFocusSessionActive": { "type": "boolean" },
        "activeFocusSubject": { "type": "string" },
        "todayStudyMinutes": { "type": "integer" },
        "todayCompletedSessions": { "type": "integer" },
        "streakDays": { "type": "integer" },
        "recentBlockedAttempt": { "type": "string" },
        "installedApps": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "childUid",
        "childName",
        "deviceModel",
        "androidVersion",
        "batteryPercent",
        "isCharging",
        "usageAccessGranted",
        "notificationsGranted",
        "supervisionServiceRunning",
        "totalPhoneScreenMinutesToday",
        "installedApps",
        "createdAt",
        "updatedAt"
      ]
    },
    "ParentControlRules": {
      "title": "ParentControlRules",
      "description": "Remote parental controls governing the child's phone lock, blocked apps, daily screen limits, study-only mode, nudges, and assigned study tasks.",
      "type": "object",
      "properties": {
        "childUid": { "type": "string" },
        "parentUid": { "type": "string" },
        "isPhoneLocked": { "type": "boolean" },
        "lockMessage": { "type": "string" },
        "dailyScreenLimitMinutes": { "type": "integer" },
        "bonusMinutesToday": { "type": "integer" },
        "bonusDay": { "type": "string" },
        "bedtimeEnabled": { "type": "boolean" },
        "bedtimeStart": { "type": "string" },
        "bedtimeEnd": { "type": "string" },
        "blockedPackages": { "type": "array" },
        "studyOnlyMode": { "type": "boolean" },
        "parentNudgeText": { "type": "string" },
        "parentNudgeNonce": { "type": "integer" },
        "parentPin": { "type": "string" },
        "assignedSubject": { "type": "string" },
        "assignedDurationMinutes": { "type": "integer" },
        "assignedAlarmTime": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "childUid",
        "parentUid",
        "isPhoneLocked",
        "dailyScreenLimitMinutes",
        "bonusMinutesToday",
        "bedtimeEnabled",
        "blockedPackages",
        "studyOnlyMode",
        "parentNudgeNonce",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChildScreenShare": {
      "title": "ChildScreenShare",
      "description": "Explicitly consented live screen snapshot shared by the child's device via MediaProjection for the linked parent to view.",
      "type": "object",
      "properties": {
        "childUid": { "type": "string" },
        "isSharing": { "type": "boolean" },
        "frameBase64": { "type": "string" },
        "frameWidth": { "type": "integer" },
        "frameHeight": { "type": "integer" },
        "frameSeq": { "type": "integer" },
        "captureMode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "childUid",
        "isSharing",
        "frameBase64",
        "frameWidth",
        "frameHeight",
        "frameSeq",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores each authenticated user's profile, role, syllabus details, and settings."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "Stores each user's focus sessions."
    },
    "/pairingCodes/{code}": {
      "schema": { "$ref": "#/entities/PairingCode" },
      "description": "One-time 6-character pairing codes created by children for parent linking."
    },
    "/familyLinks/{linkId}": {
      "schema": { "$ref": "#/entities/FamilyLink" },
      "description": "Parent-child supervision relationships keyed as {parentUid}_{childUid}."
    },
    "/users/{userId}/deviceState/current": {
      "schema": { "$ref": "#/entities/ChildDeviceState" },
      "description": "Real-time phone telemetry and app usage snapshot synced from child's phone."
    },
    "/users/{userId}/parentControls/current": {
      "schema": { "$ref": "#/entities/ParentControlRules" },
      "description": "Parental control rules, locks, blocked apps, and remote nudges managed by the linked parent."
    },
    "/users/{userId}/screenShare/current": {
      "schema": { "$ref": "#/entities/ChildScreenShare" },
      "description": "Consented live screen share frame and status published strictly by the child's device for linked parents."
    }
  }
}
